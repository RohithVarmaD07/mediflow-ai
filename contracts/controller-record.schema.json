{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mediflow-ai:controller-record:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "invocation_id",
    "run_id",
    "attempt_id",
    "recovery_of_run_id",
    "stage_id",
    "attempt_number",
    "sequence",
    "occurred_at",
    "elapsed_seconds",
    "status",
    "error_code",
    "error_type",
    "root_ref",
    "evidence_refs"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "record_type": {
      "const": "stage_transition"
    },
    "invocation_id": {
      "type": "string",
      "format": "uuid"
    },
    "run_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "attempt_id": {
      "type": "string",
      "format": "uuid"
    },
    "recovery_of_run_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "stage_id": {
      "enum": [
        "startup",
        "lock",
        "connect",
        "recover",
        "ingest",
        "prepare",
        "commit",
        "publish",
        "finalize"
      ]
    },
    "attempt_number": {
      "type": "integer",
      "minimum": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "elapsed_seconds": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "status": {
      "enum": [
        "running",
        "succeeded",
        "failed",
        "blocked"
      ]
    },
    "error_code": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 64
    },
    "error_type": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 64
    },
    "root_ref": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 240
    },
    "evidence_refs": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "string",
        "maxLength": 240
      }
    }
  },
  "description": "Internal stage history, not the DataOps integration contract. Semantic path, transition and size validation required."
}
